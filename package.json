{
  "name": "@tychenjiajun/pi-codebuddy-oauth",
  "version": "0.1.8",
  "description": "Pi extension that registers CodeBuddy (IOA, Tencent) as an OpenAI-compatible HTTP provider with OAuth login or API-key auth, auto model discovery, and retries",
  "homepage": "https://pi.dev/packages/@tychenjiajun/pi-codebuddy-oauth",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/tychenjiajun/pi-codebuddy-oauth/main/assets/preview.png",
    "video": "https://raw.githubusercontent.com/tychenjiajun/pi-codebuddy-oauth/main/assets/demo.mp4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "extension",
    "codebuddy",
    "ioa",
    "oauth",
    "provider",
    "openai-compatible",
    "api-key"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-codebuddy-oauth.git"
  },
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-codebuddy-oauth/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
